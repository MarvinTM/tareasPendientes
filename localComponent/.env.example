# ── Modbus / poller target (Huawei WiFi dongle) ──────────────────
MODBUS_HOST=192.168.1.230
MODBUS_PORT=502

# ── Forwarder: where to read the snapshot from + where to post it ──
POLLER_URL=http://127.0.0.1:8765
BACKEND_URL=https://myapp.example.com
API_KEY=your-api-key
POLL_INTERVAL=5000

# Per-field staleness: fields older than this (ms) are sent as null to the
# backend instead of discarding the whole reading. Default 60s.
MAX_AGE_MS=60000

# ── Battery sign/multiplier (LEGACY-PARITY defaults for A/B compare) ──
# These default to the values the old ingest.js sent to the backend, so the
# frontend energy-balance chart stays identical during cutover. See
# localComponent/README.md "Battery sign & power multiplier" before changing.
BATTERY_POWER_MULTIPLIER=2.0
BATTERY_CURRENT_NEGATE=true