# ── Modbus / poller target (Huawei WiFi dongle) ──────────────────
MODBUS_HOST=192.168.1.230
MODBUS_PORT=502

# ── Forwarder: where to read the snapshot from + where to post it ──
POLLER_URL=http://127.0.0.1:8765
BACKEND_URL=https://myapp.example.com
API_KEY=your-api-key
POLL_INTERVAL=5000

# Per-field staleness: fields older than this (ms) are sent as null to the
# backend instead of discarding the whole reading. Default 60s.
MAX_AGE_MS=600000

# ── Battery sign/multiplier (LEGACY-PARITY defaults for A/B compare) ──
# These default to the values the old ingest.js sent to the backend, so the
# frontend energy-balance chart stays identical during cutover. See
# localComponent/README.md "Battery sign & power multiplier" before changing.
BATTERY_POWER_MULTIPLIER=2.0
BATTERY_CURRENT_NEGATE=true

# ── Plausibility validation (prevent corrupted readings from entering history) ──
# A "successful" Modbus read can still return a well-formed frame whose
# payload is 0x0000 or garbage. The forwarder nulls-out values that violate
# the bounds below so they render as gaps / "Error lectura" downstream
# instead of corrupting the historical data (e.g. battery 0% when full,
# grid export 0 W when actually exporting ~1500 W).
# Per-field physical bounds (values outside are treated as read errors):
# BOUND_PV_VOLT_MIN=0       BOUND_PV_VOLT_MAX=1000
# BOUND_GRID_VOLT_MIN=150   BOUND_GRID_VOLT_MAX=300
# BOUND_TEMP_MIN=-20        BOUND_TEMP_MAX=90
# BOUND_BATT_SOC_MIN=0      BOUND_BATT_SOC_MAX=100
# BOUND_BATT_VOLT_MIN=0     BOUND_BATT_VOLT_MAX=1000
# BOUND_ACTIVE_PWR_MIN=-50000  BOUND_ACTIVE_PWR_MAX=50000
# BOUND_METER_PWR_MIN=-50000   BOUND_METER_PWR_MAX=50000
# Cross-field checks:
# BATT_PRESENT_VOLTAGE=300   # voltage(V) above which battery rack is online;
#                             # SOC=0 with voltage above this → suspect → null
# METER_ZERO_DEADBAND=10      # |meterPower| below this while inverter is flowing
# METER_FLOW_THRESHOLD=200   # significant power → meter read is suspect → null
METER_FLOW_THRESHOLD=0

# ── Poller self-healing (Phase 2.1 + 2.3) ────────────────────────────
# These knobs let the poller detect and recover a TCP-alive-but-Modbus-dead
# socket on its own, without the forwarder or a human intervening. They
# are the direct fix for the 2026-07-12 16:01–17:21 incident where a
# "connection reset by peer" (FusionSolar stealing the single-allowed
# Modbus slot) was followed by an 80-minute hang in which every read
# timed out but the connection was never closed.
#
# LINK_MAX_TIMEOUTS=3
#   Consecutive-timeout circuit breaker. After this many ErrTimeouts in
#   a row on the same connection with no successful read in between,
#   force-close the socket so the next read redials. 0 disables (legacy
#   "keep alive forever" behaviour that caused the hang). Warm-up reads
#   are exempt by design (Huawei dongle ignores the first read after a
#   TCP connect — see poller/internal/modbus/link.go).
#
# LINK_FRESHNESS_MS=45000
#   Last-success watchdog. If no successful Modbus read has occurred in
#   this duration, force-close the connection. Catches stalls the per-read
#   breaker can't — e.g. reads that succeed-but-take-30s-each (ErrTimeout
#   never fires but lastSuccess ages out), or a scheduler goroutine death
#   where nobody is even issuing reads. Complements LINK_MAX_TIMEOUTS;
#   does NOT replace it.
LINK_MAX_TIMEOUTS=6
LINK_READ_TIMEOUT_MS=10000
LINK_FRESHNESS_MS=120000
LINK_COOLOFF_MS=5000

# ── Forwarder-side poller watchdog (Phase 2.5) ───────────────────────
# Layered defense: if the poller's *own* self-healing above fails to
# recover (process wedge, scheduler death, or self-heal threshold too
# generous for the current incident), the forwarder — a separate PM2
# process — restarts the poller process. Without ever requiring a human
# to SSH in and `pm2 restart local-poller` by hand.
#
# Two trip conditions, each throttled to one restart per cooldown:
#   1. /snapshot reachable but link.lastSuccess older than POLLER_STALE_MS
#      for POLLER_STALE_CYCLES consecutive fetches.
#   2. /snapshot unreachable for POLLER_DOWN_CYCLES consecutive fetches
#      (poller HTTP server dead = process wedge).
#
# Defaults intentionally generous: a normal degraded window (poller still
# gets *some* reads through every few seconds) does NOT trip — only a
# true prolonged stall does. Tune lower if you want faster escalation,
# higher if you see false restarts during known-bad dongle periods.
POLLER_STALE_MS=300000
POLLER_STALE_CYCLES=2
POLLER_DOWN_CYCLES=6
POLLER_RESTART_COOLDOWN_MS=300000
POLLER_RESTART_CMD=pm2 restart local-poller --update-env
